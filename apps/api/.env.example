# ==============================================================================
# ASTU EXPRESS CLOUDFLARE WORKERS API ENVIRONMENT TEMPLATE
# Copy this file to .env or .dev.vars for local wrangler development
# ==============================================================================

# Better Auth Secret (Minimum 32 random characters for session encryption)
BETTER_AUTH_SECRET=change_me_to_a_secure_32_character_random_secret_string

# Better Auth Base URL (Worker URL)
BETTER_AUTH_URL=http://localhost:8787

# Trusted Origins (Comma-separated URLs allowed to authenticate via CORS)
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Initial Master Admin Credentials (Used strictly during /api/admin/init-database)
ADMIN_BOOTSTRAP_EMAIL=admin@astuexpress.com
ADMIN_BOOTSTRAP_PASSWORD=AstuExpressSecurePassword2026!

# Chapa Payment Gateway Configuration
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_hash_here
API_BASE_URL=http://localhost:8787
